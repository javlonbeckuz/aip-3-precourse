# Port the HTTP server listens on (Railway sets it for you)
PORT=3000
# "production" turns on Secure cookies with the __Host- prefix and HSTS, hides the demo account XM and ignores NOW
NODE_ENV=development
# Folder for the SQLite file aip.db: point it at the volume (Railway: /data, droplet: /var/lib/aip)
DATA_DIR=./data
# Folder with schedule.json, lessons/ and prep/ (edit files here, no restart needed)
CONTENT_DIR=./content
# Folder with the built SPA (shell is public/aip/index.html or public/index.html)
PUBLIC_DIR=./public
# Public address of the portal, used in the bot's student message and the login origin check
PORTAL_URL=http://localhost:3000/aip/
# Reverse proxies in front of the app, a non-negative integer (anything else stops the server): Railway = 2 (measured 2026-10-19), Cloudflare + Railway = 3, direct = 0. The client is the n-th address from the right of X-Forwarded-For
TRUST_PROXY=0
# 1 = trust CF-Connecting-IP. Only safe when ALL traffic comes through Cloudflare: remove or block the *.up.railway.app domain, or anyone can forge the header
TRUST_CF=0
# Address to bind: 0.0.0.0 on Railway, 127.0.0.1 on a droplet behind Caddy
HOST=0.0.0.0
# The mentor account XM (log in as XM or AIP-XM) is always active with every dated lesson open. 0 = switch it off (anyone who knows XM gets in)
# XM_ADMIN=0
# Tests and dev only, while XM_ADMIN=0: 1 = XM as a plain demo student
# SEED_DEMO=1
# Admin bot token from BotFather. Leave empty to run without the bot
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the admin bot (ask @userinfobot for your ID)
ADMIN_TG_IDS=
# Secret the CRM sends as "Authorization: Bearer <key>" to POST /api/int/students (at least 32 characters; unset = endpoint off, 404). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTEGRATION_KEY=
# TESTING ONLY: pretend it is this time (Asia/Tashkent unless a zone is given). Needs ALLOW_NOW=1; the server refuses to start with NOW + https PORTAL_URL or a proxy setting
# NOW=2026-09-12T09:59
# ALLOW_NOW=1
