# Copy this file to .env and fill it in:  cp .env.example .env
# .env holds secrets. Never paste it into a chat, never commit it, never show it on screen.

# ---------------------------------------------------------------- required
# Telegram bot token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# OpenRouter key from https://openrouter.ai/keys . Set a monthly limit on the key itself.
OPENROUTER_API_KEY=
# Your own numeric Telegram ID: reports, alerts and hand-overs come here.
# Send /id to your bot to see it.
OWNER_CHAT_ID=

# ---------------------------------------------------------------- who may use the bot
# staff  = only the IDs below (and people added with /ruxsat)
# public = anyone (customers); then each person gets PUBLIC_DAILY_LIMIT_PER_USER questions a day
ACCESS_MODE=staff
ALLOWED_USER_IDS=
# The pilot lead (loyiha yetakchisi) can also /stop, /davom, /hisobot. The owner is always admin.
ADMIN_USER_IDS=
PUBLIC_DAILY_LIMIT_PER_USER=20

# ---------------------------------------------------------------- the agent
COMPANY_NAME=Baraka Office
AGENT_NAME=Savdo yordamchisi
# direct  = the bot answers at once, staff press ✅ / ❌
# approve = week one of the pilot: a person approves every answer before it is sent
# topics  = week two: answers on the topics in agent/approval.toml (direct_topics) go at once,
#           every other answer waits for the reviewer (agent/approval.qollanma.md)
REPLY_MODE=direct
# Who approves drafts (approve and topics modes) and who gets hand-overs (Kit 3 B.6). Empty = the owner.
REVIEWER_CHAT_ID=
ESCALATION_CHAT_ID=
FEEDBACK_BUTTONS=on
# How many previous question/answer pairs the bot remembers in one chat.
HISTORY_TURNS=6

# ---------------------------------------------------------------- model and money
# cheap | balanced | strong
MODEL_TIER=balanced
# Prices per 1M tokens (input / output) from openrouter.ai/api/v1/models, checked 2026-11-03.
MODEL_CHEAP=anthropic/claude-haiku-5.5
# $0.10 / $0.50
MODEL_BALANCED=google/gemini-3.8-flash
# $0.825 / $4.125
MODEL_STRONG=anthropic/claude-sonnet-5.5
# $2.00 / $10.00
# Open-weight alternative to compare on Day 1 and Day 5: deepseek/deepseek-v4.1-flash ($0.045 / $0.50)
MAX_ANSWER_TOKENS=700
# The bot stops calling the model at these caps (USD) and hands questions to a person.
DAILY_BUDGET_USD=1.00
MONTHLY_BUDGET_USD=15.00

# ---------------------------------------------------------------- schedule and pilot
TIMEZONE=Asia/Tashkent
# Daily report to the owner (empty = off). Weekly Kit 5 file on this weekday (1 = Monday, empty = off).
DAILY_REPORT_TIME=09:00
WEEKLY_REPORT_DAY=1
# Staff get bot messages (hand-overs, drafts) only in working hours; the owner gets them any time.
WORK_HOURS=09:00-18:00
WORK_DAYS=1-6
# Go-live day of the pilot: weekly numbers are counted as 1-hafta, 2-hafta from here.
PILOT_START_DATE=
# Journal days are deleted after this many days.
LOG_RETENTION_DAYS=60
# Largest data block sent to the model (characters). Bigger data: only the rows closest to the question.
DATA_MAX_CHARS=12000

# Only for the course's Baraka Office demo: lets `pilot check` pass while the Baraka sample files are still
# in agent/ and data/. Never set this for a real company: the check then stops a deploy with Baraka's data.
# DEMO_SAMPLE=on

# ---------------------------------------------------------------- deploy (used by deploy/deploy.py)
# The server, as you log in to it: root@203.0.113.10 or an alias from ~/.ssh/config
DEPLOY_HOST=
